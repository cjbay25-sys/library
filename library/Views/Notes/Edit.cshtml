@model library.Models.Note

@{
    ViewData["Title"] = "Edit Note";
}

<h1>Edit Note</h1>

<form asp-action="Edit" asp-route-id="@Model.NoteId" method="post">
    <input type="hidden" asp-for="NoteId" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control"
               maxlength="100" required />
    </div>

    <div class="mb-3">
        <label asp-for="Body" class="form-label"></label>
        <textarea asp-for="Body" class="form-control"
                  rows="5"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="CreatedOn" class="form-label">Created On</label>
        <input asp-for="CreatedOn" type="date"
               class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
