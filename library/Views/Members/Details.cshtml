@model library.Models.MemberDetails
@{
    ViewData["Title"] = Model.Member.FullName;
    var booksOut = Model.Loans.Count(l => l.ReturnedOn == null);
}

<div class="d-flex align-items-center gap-3 mb-4">
    <div class="avatar">@(Model.Member.FullName.Length > 0 ? Model.Member.FullName[0] : '?')</div>
    <div>
        <h1 class="mb-0">@Model.Member.FullName</h1>
        <div class="text-muted">
            <span class="badge text-bg-secondary">@Model.Member.MemberType</span>
            · ✉ @(Model.Member.Email ?? "no email")
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat stat-out">
            <div class="stat-number">@booksOut</div>
            <div class="stat-label">📖 Books out</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat stat-returned">
            <div class="stat-number">@Model.Loans.Count</div>
            <div class="stat-label">📚 Loans in total</div>
        </div>
    </div>
</div>

<h2 class="h5 mb-3">Loans</h2>
@if (Model.Loans.Count == 0)
{
    <div class="msg" style="background: rgba(255,255,255,.04); border-color: #6c757d;">
        <span class="msg-icon">📭</span>
        <div>This member has never borrowed a book.</div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var loan in Model.Loans)
        {
            <div class="col-md-6">
                <div class="loan-card loan-@loan.Status.ToLower()">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="loan-book">@loan.BookTitle</div>
                        <span class="pill pill-@loan.Status.ToLower()">
                            @(loan.Status == "Overdue" ? "⏰" : loan.Status == "Out" ? "📖" : "✅") @loan.Status
                        </span>
                    </div>
                    <div class="loan-meta">
                        Loaned @(loan.LoanedOn.ToString("yyyy-MM-dd"))
                        · Returned @(loan.ReturnedOn?.ToString("yyyy-MM-dd") ?? "—")
                    </div>
                </div>
            </div>
        }
    </div>
}

<a asp-action="Index" class="btn btn-outline-secondary mt-4">← Back to members</a>