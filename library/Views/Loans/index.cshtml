@model List<library.Models.LoanView>
@{
    ViewData["Title"] = "Loans";
    var outCount = Model.Count(l => l.Status == "Out");
    var overdueCount = Model.Count(l => l.Status == "Overdue");
    var returnedCount = Model.Count(l => l.Status == "Returned");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0">📚 Loans</h1>
        <p class="text-muted mb-0">@Model.Count loans, newest first</p>
    </div>
    <a asp-action="Borrow" class="btn btn-primary">＋ Borrow a book</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-4">
        <div class="stat stat-out">
            <div class="stat-number">@outCount</div>
            <div class="stat-label">📖 Out now</div>
        </div>
    </div>
    <div class="col-4">
        <div class="stat stat-overdue">
            <div class="stat-number">@overdueCount</div>
            <div class="stat-label">⏰ Overdue</div>
        </div>
    </div>
    <div class="col-4">
        <div class="stat stat-returned">
            <div class="stat-number">@returnedCount</div>
            <div class="stat-label">✅ Returned</div>
        </div>
    </div>
</div>

<div class="row g-3">
    @foreach (var loan in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="loan-card loan-@loan.Status.ToLower()">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div class="loan-book">@loan.BookTitle</div>
                    <span class="pill pill-@loan.Status.ToLower()">
                        @(loan.Status == "Overdue" ? "⏰" : loan.Status == "Out" ? "📖" : "✅") @loan.Status
                    </span>
                </div>

                <div class="loan-meta">
                    👤 <a asp-controller="Members" asp-action="Details" asp-route-id="@loan.MemberId">@loan.MemberName</a>
                </div>

                <div class="loan-meta">
                    Loaned @(loan.LoanedOn.ToString("yyyy-MM-dd"))
                    · Due @(loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd"))
                </div>

                <div class="loan-footer">
                    <span class="loan-meta">@loan.DaysAllowed days allowed</span>
                    @if (loan.ReturnedOn == null)
                    {
                        <form asp-action="Return" asp-route-id="@loan.LoanId" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-success">↩ Return</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>