@model library.Models.BorrowForm
@{
    ViewData["Title"] = "Borrow a book";
}

<h1 class="mb-1">📖 Borrow a book</h1>
<p class="text-muted mb-4">Choose who is borrowing, which book, and for how long.</p>

<form asp-action="Borrow" method="post" class="form-card">
    <div asp-validation-summary="ModelOnly"></div>

    <div class="row g-3">
        <div class="col-12">
            <label asp-for="MemberId" class="form-label fw-semibold">👤 Member</label>
            <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select">
                <option value="">(choose a member)</option>
            </select>
            <span asp-validation-for="MemberId"></span>
        </div>

        <div class="col-12">
            <label asp-for="BookId" class="form-label fw-semibold">📕 Book</label>
            <select asp-for="BookId" asp-items="ViewBag.Books" class="form-select">
                <option value="">(choose a book)</option>
            </select>
            <span asp-validation-for="BookId"></span>
        </div>

        <div class="col-sm-6">
            <label asp-for="DaysAllowed" class="form-label fw-semibold">🗓 Days allowed</label>
            <div class="input-group">
                <input asp-for="DaysAllowed" class="form-control" />
                <span class="input-group-text">days</span>
            </div>
            <span asp-validation-for="DaysAllowed"></span>
            <div class="form-hint">From 1 to 30 days. A member may have 3 books out at most.</div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">✔ Borrow</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}